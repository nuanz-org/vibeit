{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:runtime-frame": "esbuild runtime/frame/entry.ts --bundle --outfile=public/runtime-frame.js --format=esm --platform=browser --target=es2020 --legal-comments=none --banner:js=\"/* generated by build:runtime-frame — do not edit */\"",
    "smoke:compile": "node runtime/compile/smoke-compile.mjs",
    "dev": "pnpm run build:runtime-frame && next dev --port 3000",
    "build": "pnpm run build:runtime-frame && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "auth:migrate": "npx auth@latest migrate --yes",
    "auth:generate": "npx auth@latest generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@repo/contracts": "workspace:*",
    "@repo/ui": "workspace:*",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.30.0",
    "next": "16.2.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
