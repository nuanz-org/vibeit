# Postgres (docker compose)
POSTGRES_USER=aiditr
POSTGRES_PASSWORD=aiditr
POSTGRES_DB=aiditr
POSTGRES_PORT=5432

# App connection string (API / Better Auth / future ORM)
DATABASE_URL=postgresql://aiditr:aiditr@localhost:5432/aiditr

# Better Auth (apps/web) — generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Public API base for browser client.
# Leave empty for same-origin (Next rewrites /api/v1 → FastAPI; recommended local dev).
# Set absolute URL (e.g. http://localhost:8000) only for cross-origin setups.
NEXT_PUBLIC_API_BASE_URL=
# Server-side FastAPI origin for Next rewrites / SSR (not exposed to browser)
API_INTERNAL_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# OpenRouter / Create agent (M3) — apps/api only. Never prefix with NEXT_PUBLIC.
# Loaded automatically by the API via python-dotenv (repo root .env, then apps/api/.env).
# ASAP: only deepseek/deepseek-v4-flash is allowed (enforced in adapters/llm).
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
LLM_DEFAULT_MODEL=deepseek/deepseek-v4-flash
LLM_CODEGEN_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60000
LLM_HTTP_REFERER=http://localhost:3000
LLM_APP_TITLE=Aiditr

# Create budgets / quota (M3e–M3f)
CREATE_REPAIR_MAX=3
CREATE_WALL_TIME_SECONDS=60
CREATE_WORKER_ENABLED=true
CREATE_QUOTA_PER_DAY=10
# CREATE_TOKEN_BUDGET=
CREATE_COST_CENTS_PER_MILLION_TOKENS=15
