# Postgres (docker compose)
POSTGRES_USER=vibeit
POSTGRES_PASSWORD=vibeit
POSTGRES_DB=vibeit
POSTGRES_PORT=5432

# App connection string (API / Better Auth / future ORM)
DATABASE_URL=postgresql://vibeit:vibeit@localhost:5432/vibeit

# Better Auth (apps/web) — generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Public API base for browser client (later milestones)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
